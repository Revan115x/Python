# CREAR UN FROZENSET
numeros = frozenset([1, 2, 3, 4, 5])

# MOSTRAR CONJUNTO
print(numeros)

# COMPROBAR PERTENENCIA
print(3 in numeros)

# LONGITUD
print(len(numeros))

# MAXIMO Y MINIMO
print(max(numeros))
print(min(numeros))

# SUMA
print(sum(numeros))

# UNION
A = frozenset([1, 2, 3])
B = frozenset([3, 4, 5])

print(A | B)

# INTERSECCION
print(A & B)

# DIFERENCIA
print(A - B)